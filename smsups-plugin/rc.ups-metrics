#!/bin/bash
PLUGIN="smsups"
NAME="ups-metrics"
DAEMON="/usr/local/bin/$NAME"
PIDFILE="/var/run/$NAME.pid"
DIR="/boot/config/plugins/$PLUGIN"
CFG="$DIR/smsups.cfg"

is_enabled() {
  [ -f "$CFG" ] && grep -q "^UPS_METRICS_ENABLED=yes" "$CFG"
}

ups_metrics_start() {
  if ! is_enabled; then
    echo "$NAME is disabled in $CFG"
    return
  fi
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is already running"
    return
  fi
  if [ ! -f "$DIR/conf/config.yaml" ]; then
    echo "Config not found: $DIR/conf/config.yaml"
    return
  fi
  echo "Starting $NAME..."
  cd "$DIR" || exit 1
  nohup $DAEMON > /var/log/$NAME.log 2>&1 &
  echo $! > "$PIDFILE"
  echo "$NAME started (pid $(cat $PIDFILE))"
}

ups_metrics_stop() {
  if [ -f "$PIDFILE" ]; then
    echo "Stopping $NAME..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    echo "$NAME is not running"
  fi
}

ups_metrics_status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is running (pid $(cat $PIDFILE))"
  else
    echo "$NAME is not running"
  fi
}

case "$1" in
  start)   ups_metrics_start ;;
  stop)    ups_metrics_stop ;;
  restart) ups_metrics_stop; sleep 1; ups_metrics_start ;;
  status)  ups_metrics_status ;;
  *)       echo "usage: $0 start|stop|restart|status" ;;
esac

<!-- version omitted → auto-generated by upg.py
RC scripts installed directly — Mode attribute sets file permissions -->
<FILE Name="/etc/rc.d/rc.victorialogs" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN="smsups"
NAME="victorialogs"
DAEMON="/usr/local/bin/victoria-logs"
PIDFILE="/var/run/$NAME.pid"
CFG="/boot/config/plugins/$PLUGIN/smsups.cfg"
DATADIR="/dev/shm/vlogs-data"   # tmpfs — nunca persiste em disco
RETENTION="24h"
PORT="9428"

# Override defaults from smsups.cfg if present
if [ -f "$CFG" ]; then
  val=$(grep "^VICTORIALOGS_RETENTION=" "$CFG" | cut -d= -f2)
  [ -n "$val" ] && RETENTION="$val"
  val=$(grep "^VICTORIALOGS_PORT=" "$CFG" | cut -d= -f2)
  [ -n "$val" ] && PORT="$val"
fi

is_enabled() {
  [ -f "$CFG" ] && grep -q "^VICTORIALOGS_ENABLED=yes" "$CFG"
}

victorialogs_start() {
  if ! is_enabled; then
    echo "$NAME is disabled in $CFG"
    return 0
  fi
  if [ ! -f "$DAEMON" ]; then
    echo "$DAEMON not found — VictoriaLogs not installed, skipping"
    return 0
  fi
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is already running"
    return
  fi
  mkdir -p "$DATADIR"
  echo "Starting $NAME (data in RAM: $DATADIR, retention: $RETENTION)..."
  nohup $DAEMON \
    -storageDataPath="$DATADIR" \
    -retentionPeriod="$RETENTION" \
    -httpListenAddr=":$PORT" \
    > /var/log/$NAME.log 2>&1 &
  echo $! > "$PIDFILE"
  echo "$NAME started (pid $(cat "$PIDFILE"))"
}

victorialogs_stop() {
  if [ -f "$PIDFILE" ]; then
    echo "Stopping $NAME..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    echo "$NAME is not running"
  fi
}

victorialogs_status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is running (pid $(cat "$PIDFILE"))"
  else
    echo "$NAME is not running"
  fi
}

case "$1" in
  start)   victorialogs_start ;;
  stop)    victorialogs_stop ;;
  restart) victorialogs_stop; sleep 1; victorialogs_start ;;
  status)  victorialogs_status ;;
  *)       echo "usage: $0 start|stop|restart|status" ;;
esac

]]>
</INLINE>
</FILE>

<FILE Name="/etc/rc.d/rc.ups-metrics" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN="smsups"
NAME="ups-metrics"
DAEMON="/usr/local/bin/$NAME"
PIDFILE="/var/run/$NAME.pid"
DIR="/boot/config/plugins/$PLUGIN"
CFG="$DIR/smsups.cfg"

is_enabled() {
  [ -f "$CFG" ] && grep -q "^UPS_METRICS_ENABLED=yes" "$CFG"
}

ups_metrics_start() {
  if ! is_enabled; then
    echo "$NAME is disabled in $CFG"
    return
  fi
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is already running"
    return
  fi
  if [ ! -f "$DIR/conf/config.yaml" ]; then
    echo "Config not found: $DIR/conf/config.yaml"
    return
  fi
  echo "Starting $NAME..."
  cd "$DIR" || exit 1
  nohup $DAEMON > /var/log/$NAME.log 2>&1 &
  echo $! > "$PIDFILE"
  echo "$NAME started (pid $(cat $PIDFILE))"
}

ups_metrics_stop() {
  if [ -f "$PIDFILE" ]; then
    echo "Stopping $NAME..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    echo "$NAME is not running"
  fi
}

ups_metrics_status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is running (pid $(cat $PIDFILE))"
  else
    echo "$NAME is not running"
  fi
}

case "$1" in
  start)   ups_metrics_start ;;
  stop)    ups_metrics_stop ;;
  restart) ups_metrics_stop; sleep 1; ups_metrics_start ;;
  status)  ups_metrics_status ;;
  *)       echo "usage: $0 start|stop|restart|status" ;;
esac

]]>
</INLINE>
</FILE>

<FILE Name="/etc/rc.d/rc.smsups-bridge" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN="smsups"
NAME="smsups-bridge"
DAEMON="/usr/local/bin/smsups-nut-bridge"
PIDFILE="/var/run/$NAME.pid"
DIR="/boot/config/plugins/$PLUGIN"
CFG="$DIR/smsups.cfg"

is_enabled() {
  [ -f "$CFG" ] && grep -q "^BRIDGE_ENABLED=yes" "$CFG"
}

bridge_start() {
  if ! is_enabled; then
    echo "$NAME is disabled in $CFG"
    return
  fi
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is already running"
    return
  fi
  if [ ! -f "$DIR/conf/bridge.yaml" ]; then
    echo "Config not found: $DIR/conf/bridge.yaml"
    return
  fi
  echo "Starting $NAME..."
  cd "$DIR" || exit 1
  nohup $DAEMON -config conf/bridge.yaml > /var/log/$NAME.log 2>&1 &
  echo $! > "$PIDFILE"
  echo "$NAME started (pid $(cat $PIDFILE))"
}

bridge_stop() {
  if [ -f "$PIDFILE" ]; then
    echo "Stopping $NAME..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    echo "$NAME is not running"
  fi
}

bridge_status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is running (pid $(cat $PIDFILE))"
  else
    echo "$NAME is not running"
  fi
}

case "$1" in
  start)   bridge_start ;;
  stop)    bridge_stop ;;
  restart) bridge_stop; sleep 1; bridge_start ;;
  status)  bridge_status ;;
  *)       echo "usage: $0 start|stop|restart|status" ;;
esac

]]>
</INLINE>
</FILE>


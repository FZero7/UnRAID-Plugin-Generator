<!-- version omitted → auto-generated by upg.py
RC scripts installed directly — Mode attribute sets file permissions -->
<FILE Name="/etc/rc.d/rc.ups-metrics" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN="smsups"
NAME="ups-metrics"
DAEMON="/usr/local/bin/$NAME"
PIDFILE="/var/run/$NAME.pid"
DIR="/boot/config/plugins/$PLUGIN"
CFG="$DIR/smsups.cfg"

is_enabled() {
  [ -f "$CFG" ] && grep -q "^UPS_METRICS_ENABLED=yes" "$CFG"
}

ups_metrics_start() {
  if ! is_enabled; then
    echo "$NAME is disabled in $CFG"
    return
  fi
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is already running"
    return
  fi
  if [ ! -f "$DIR/conf/config.yaml" ]; then
    echo "Config not found: $DIR/conf/config.yaml"
    return
  fi
  echo "Starting $NAME..."
  cd "$DIR" || exit 1
  nohup $DAEMON > /var/log/$NAME.log 2>&1 &
  echo $! > "$PIDFILE"
  echo "$NAME started (pid $(cat $PIDFILE))"
}

ups_metrics_stop() {
  if [ -f "$PIDFILE" ]; then
    echo "Stopping $NAME..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    echo "$NAME is not running"
  fi
}

ups_metrics_status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is running (pid $(cat $PIDFILE))"
  else
    echo "$NAME is not running"
  fi
}

case "$1" in
  start)   ups_metrics_start ;;
  stop)    ups_metrics_stop ;;
  restart) ups_metrics_stop; sleep 1; ups_metrics_start ;;
  status)  ups_metrics_status ;;
  *)       echo "usage: $0 start|stop|restart|status" ;;
esac

]]>
</INLINE>
</FILE>

<FILE Name="/etc/rc.d/rc.smsups-bridge" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN="smsups"
NAME="smsups-bridge"
DAEMON="/usr/local/bin/smsups-nut-bridge"
PIDFILE="/var/run/$NAME.pid"
DIR="/boot/config/plugins/$PLUGIN"
CFG="$DIR/smsups.cfg"

is_enabled() {
  [ -f "$CFG" ] && grep -q "^BRIDGE_ENABLED=yes" "$CFG"
}

bridge_start() {
  if ! is_enabled; then
    echo "$NAME is disabled in $CFG"
    return
  fi
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is already running"
    return
  fi
  if [ ! -f "$DIR/conf/bridge.yaml" ]; then
    echo "Config not found: $DIR/conf/bridge.yaml"
    return
  fi
  echo "Starting $NAME..."
  cd "$DIR" || exit 1
  nohup $DAEMON -config conf/bridge.yaml > /var/log/$NAME.log 2>&1 &
  echo $! > "$PIDFILE"
  echo "$NAME started (pid $(cat $PIDFILE))"
  # At boot NUT starts before the bridge, and rc.nut aborts entirely (driver,
  # upsd and upsmon) when /tmp/smsups.dev is missing. The bridge only writes
  # the file after the first successful ups-metrics fetch (15s tick + UPS
  # login), so wait for it in background and then restart the full NUT stack.
  if [ -f /etc/nut/ups.conf ] && grep -q "dummy-ups" /etc/nut/ups.conf; then
    (
      for _ in $(seq 1 30); do
        [ -f /tmp/smsups.dev ] && break
        sleep 2
      done
      if [ -f /tmp/smsups.dev ] && ! pgrep -x upsd >/dev/null 2>&1; then
        /etc/rc.d/rc.nut restart >/dev/null 2>&1
      fi
    ) &
  fi
}

bridge_stop() {
  if [ -f "$PIDFILE" ]; then
    echo "Stopping $NAME..."
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "$NAME stopped"
  else
    echo "$NAME is not running"
  fi
}

bridge_status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "$NAME is running (pid $(cat $PIDFILE))"
  else
    echo "$NAME is not running"
  fi
}

case "$1" in
  start)   bridge_start ;;
  stop)    bridge_stop ;;
  restart) bridge_stop; sleep 1; bridge_start ;;
  status)  bridge_status ;;
  *)       echo "usage: $0 start|stop|restart|status" ;;
esac

]]>
</INLINE>
</FILE>


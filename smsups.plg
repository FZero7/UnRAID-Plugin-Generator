]>

<PLUGIN name="&name;" author="&author;" repo="&repo;" tag="&tag;" launch="&launch;" icon="&icon;" min="&min;" forgejo="&forgejo;" pluginURL="&pluginURL;" packageURL="&packageURL;" version="&version;" MD5="&MD5;">


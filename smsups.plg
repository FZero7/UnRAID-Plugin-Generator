<div class="smsups-container">
    <h2><i class="fa fa-battery-full"></i> SMS UPS Monitor</h2>

    <div class="status-bar">
        <span id="status-ups">ups-metrics: <i>checking...</i></span>
        &nbsp;|&nbsp;
        <span id="status-bridge">NUT Bridge: <i>checking...</i></span>
        &nbsp;|&nbsp;
        <span id="status-vl">VictoriaLogs: <i>checking...</i></span>
    </div>

    <div class="autostart-row">
        <label>

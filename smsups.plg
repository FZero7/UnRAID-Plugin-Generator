<PLUGIN name="&name;" slug="&slug;" author="&author;" repo="&repo;" tag="&tag;" launch="&launch;" icon="&icon;" min="&min;" github="&github;" pluginURL="&pluginURL;" packageURL="&packageURL;" MD5="&MD5;" version="&version;">


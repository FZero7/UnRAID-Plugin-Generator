            <button class="smsups-btn" onclick="svcAction('ups-metrics', 'start')">&#9654; Start</button>
            <button class="smsups-btn danger" onclick="svcAction('ups-metrics', 'stop')">&#9632; Stop</button>
            <button class="smsups-btn" onclick="svcAction('ups-metrics', 'restart')">&#8635; Restart</button>
        </div>

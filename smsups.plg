    <div id="output"></div>
</div>

<script>
var api = '/plugins/smsups/php/exec.php';

function switchTab(id, btn) {
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
}

function out(msg) {
    document.getElementById('output').textContent = msg;
}

function saveConfig(service, textareaId) {
    var content = document.getElementById(textareaId).value;
    $.post(api, { action: 'save', service: service, config: content }, out);
}

function svcAction(service, action) {
    $.post(api, { action: action, service: service }, out);
    setTimeout(updateStatus, 1500);
}

function allAction(action) {
    $.post(api, { action: action }, out);
    setTimeout(updateStatus, 1500);
}

function setAutostart(service, enabled) {
    $.post(api, { action: 'set_autostart', service: service, enabled: enabled ? 'yes' : 'no' }, out);
}

function updateStatus() {
    $.get(api, { action: 'status', service: 'ups-metrics' }, function(d) {
        document.getElementById('status-ups').innerHTML = 'ups-metrics: <b>' + d + '</b>';
    });
    $.get(api, { action: 'status', service: 'bridge' }, function(d) {
        document.getElementById('status-bridge').innerHTML = 'NUT Bridge: <b>' + d + '</b>';
    });
}

updateStatus();
setInterval(updateStatus, 10000);
</script>

]]>

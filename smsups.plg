$ups_enabled    = false;
$bridge_enabled = false;
$vl_enabled     = false;
$vl_retention   = "24h";
$vl_port        = "9428";

if (file_exists($cfg_file)) {
    $cfg_content = file_get_contents($cfg_file);
    $ups_enabled    = strpos($cfg_content, 'UPS_METRICS_ENABLED=yes') !== false;
    $bridge_enabled = strpos($cfg_content, 'BRIDGE_ENABLED=yes') !== false;
    $vl_enabled     = strpos($cfg_content, 'VICTORIALOGS_ENABLED=yes') !== false;
    if (preg_match('/^VICTORIALOGS_RETENTION=(.+)$/m', $cfg_content, $m)) $vl_retention = trim($m[1]);
    if (preg_match('/^VICTORIALOGS_PORT=(.+)$/m',      $cfg_content, $m)) $vl_port      = trim($m[1]);
}

$ups_config_content    = file_exists($ups_cfg)    ? htmlspecialchars(file_get_contents($ups_cfg))    : "";
$bridge_config_content = file_exists($bridge_cfg) ? htmlspecialchars(file_get_contents($bridge_cfg)) : "";
?>


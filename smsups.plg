        <button class="smsups-btn" onclick="allAction('restart_all')">&#8635; Restart All</button>
    </div>

    <div>
        <button class="tab-btn active" onclick="switchTab('tab-ups', this)">ups-metrics</button>
        <button class="tab-btn" onclick="switchTab('tab-bridge', this)">NUT Bridge</button>
        <button class="tab-btn" onclick="switchTab('tab-vl', this)">VictoriaLogs</button>
    </div>

    <div id="tab-ups" class="tab-content active">
        <textarea id="cfg-ups" class="smsups-textarea" spellcheck="false"><?= $ups_config_content ?></textarea>
